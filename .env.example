# E2EE 认证服务基地址（E2EE 用户服务，Spring Boot :18080）
# - 本地开发：保持默认即可
# - 生产部署：改为实际后端地址，如 https://auth.example.com/api/auth
# - 注意：修改后需重启 dev server / 重新构建生效
VITE_AUTH_API_BASE_URL=http://localhost:18080/api/auth
